# Where the mobile app looks for the backend API.
#
# Copy this file to .env before running the app locally:
#   cp .env.example .env
#
# The variable is EXPO_PUBLIC_API_HOST, not EXPO_PUBLIC_API_URL -- it is the
# scheme, host and port with no path, and services/api.js appends the rest.
# Expo only passes variables through to the bundle if they start with
# EXPO_PUBLIC_, so the prefix is load-bearing.
#
# The value is read at BUILD time, not at runtime -- the Expo web export bakes
# it into the bundle. Changing it means rebuilding, not just restarting.
#
# Point it somewhere nothing is listening and every screen fails with
# "Network error. Please try again." at the login form, which looks like a
# broken app rather than a misconfigured host. The committed .env had a port
# nothing serves for months for exactly that reason.

# ─── Local development ──────────────────────────────────────────────────────
# The backend's own default, and the port the Playwright mobile suite boots it
# on. Use this unless you have deliberately moved it.
EXPO_PUBLIC_API_HOST=http://localhost:8080

# ─── Android emulator ───────────────────────────────────────────────────────
# localhost inside the emulator is the emulator itself, not your machine, so a
# local backend is unreachable at that name however it is started. 10.0.2.2 is
# the host loopback as seen from an Android AVD.
#
#   EXPO_PUBLIC_API_HOST=http://10.0.2.2:8080
#
# A physical Android device on the same wi-fi needs your machine's LAN address
# instead (http://192.168.x.x:8080), and the backend has to be listening on all
# interfaces rather than only 127.0.0.1.

# ─── Production ─────────────────────────────────────────────────────────────
# What render.yaml sets for the acadia-mobile-web static build. portal.concept-
# edu.com is a CNAME to this same service, so either name reaches one backend.
#
#   EXPO_PUBLIC_API_HOST=https://acadia-backend-sg.onrender.com
