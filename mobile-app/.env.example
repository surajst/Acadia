# Where the mobile app looks for the backend API.
#
# Copy this file to .env before running the app locally:
#   cp .env.example .env
#
# This must match the port the backend is actually serving on (the Playwright
# mobile suite boots it on 8080). Point it somewhere else and every screen
# fails with "Network error. Please try again." at the login form, which looks
# like a broken app rather than a misconfigured host.
#
# The value is read at BUILD time, not at runtime -- the Expo web export bakes
# it into the bundle. Changing it means rebuilding, not just restarting.
EXPO_PUBLIC_API_HOST=http://localhost:8080
